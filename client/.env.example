# Backend WebSocket URL (e.g. wss://your-service.onrender.com)
VITE_WS_URL=ws://localhost:5000

# Backend HTTP API URL (e.g. https://your-service.onrender.com)
VITE_API_URL=http://localhost:5000

# Tldraw v5 production license key (Required for deployed domains outside localhost)
